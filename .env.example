# MongoDB connection string (e.g. a MongoDB Atlas cluster). Required.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sitewyre

# Shared secret required in the `Authorization: Bearer <key>` header for
# every write (POST/PATCH/DELETE) request. Generate a long random string.
ADMIN_API_KEY=

# Comma-separated list of origins allowed to call this API from a browser.
ALLOWED_ORIGINS=http://localhost:3000,https://sitewyre.com

# Resend (https://resend.com) API key used to email lead notifications.
# Leave blank to skip email sending — leads still save to MongoDB either way.
RESEND_API_KEY=

# "From" and notification "to" addresses for lead emails. FROM_EMAIL must be
# on a domain verified with Resend.
LEADS_FROM_EMAIL=leads@sitewyre.com
LEADS_NOTIFY_EMAIL=hello@sitewyre.com

PORT=4000
